# .env.example 을 복사해 .env 로 만들어 사용한다. (.env 는 Git에 올리지 않는다)

# 저장소 구현 선택: sqlite (로컬, 로그인 없음) | supabase (클라우드, 로그인 필요)
DB_BACKEND=sqlite

# --- sqlite 모드 ---
# SQLite 파일 경로 (프로젝트 폴더 기준 상대경로 또는 절대경로)
DB_PATH=todo.db

# --- supabase 모드 ---
# Supabase 대시보드 → Project Settings → API Keys / Data API 에서 확인
# publishable 키만 넣는다. secret 키 / service_role 키는 RLS를 우회하므로 절대 넣지 않는다.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# 세션 쿠키 Secure 속성: 로컬(http://localhost)은 false, 배포(https)는 true
COOKIE_SECURE=false

# --- RLS 검증 스크립트(scripts/rls_check.py) 전용 테스트 계정 ---
# Supabase 대시보드에서 만든 테스트 계정. 실제 개인 계정·비밀번호를 쓰지 않는다.
RLS_TEST_A_EMAIL=
RLS_TEST_A_PASSWORD=
RLS_TEST_B_EMAIL=
RLS_TEST_B_PASSWORD=
